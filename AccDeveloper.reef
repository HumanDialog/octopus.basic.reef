----------- GroupMember ------------------------------------------------

access role Developer: Developer
    acc App = ACC_READ

    acc User = self.AccDeveloper

    acc Group = self.AccDeveloper

    acc TaskList = self.AccDeveloper

    acc UserTaskList = self.List.AccDeveloper

    acc Task = self.AccDeveloper

    acc TaskNote = self.Task.AccDeveloper

    acc Folder = self.AccDeveloper

    acc FolderFolder = self.InFolder.acc

    acc FolderNote = self.Folder.acc

    acc FolderTask = self.Folder.acc

    acc Note = self.AccDeveloper

    acc MessageChannel = self.AccDeveloper

    acc Message = self.AccDeveloper

    acc UploadedFile = self.AccDeveloper

    acc FolderFile = self.Folder.acc

    acc TaskFile = self.Task.AccDeveloper

    acc NoteFile = self.Note.AccDeveloper

    acc NoteNote = self.Note.AccDeveloper

    acc Project = self.AccDeveloper

--std
context User::AccDeveloper: integer
post:
    if self = user then
        result = ACC_READWRITE
    else if self.Groups.exists(element.GroupId = group.Id) then
        result = ACC_READ --ACC_READ_REF, ACC_READ_BASIC
    end if
    end if

context Group::AccDeveloper: integer
post:
    if group = self then
        result = ACC_READWRITE
    end if

context TaskList::AccDeveloper: integer
post:
    if self.User = user then
        result = ACC_READWRITE
    else if self.Group then
        result = ACC_READWRITE
    end if
    end if


context Task::AccDeveloper: integer
post:
    ---- Safety
    if self.CreatedBy = user or self.Actor = user or self.TaskList.UserId = user.Id then
        result = ACC_READWRITE

    else

    if user.IsInGroupId(self.TaskList.GroupId)then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user or self.Actor = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if
    case ACC_GROUP, ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        if user.IsInGroupId(self.GroupId) then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if
    end if



-- Every object has User and Group
-- AccCode points checking criteria
--   but: Owner has superpower access becouse of elements creation
context Folder::AccDeveloper: integer
post:
    if self.Owner = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.Owner = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_GROUP, ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        if user.IsInGroupId(self.GroupId) then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if

context Note::AccDeveloper: integer
post:
    if self.CreatedBy = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_GROUP, ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        if user.IsInGroupId(self.GroupId) then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if

context MessageChannel::AccDeveloper
post:
    if self.Group = group then
        result = ACC_READ
    else if self.Users.exists(element.UserId = user.Id) then
        result = ACC_READ
    end if
    end if

context Message::AccDeveloper
post:
    if self.Author = self then
        result = ACC_READWRITE
    else if self.Channel.acc >= ACC_READ then
        result = ACC_READ
    end if
    end if

context UploadedFile::AccDeveloper: integer
post:
    if self.CreatedBy = user then
        result = ACC_READ

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READ
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if
    case ACC_GROUP, ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        if user.IsInGroupId(self.GroupId) then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if

context Project::AccDeveloper: integer
post:
    if self.Group = group then
        result = ACC_READ
    end if
