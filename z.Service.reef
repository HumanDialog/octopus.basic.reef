context App::DeleteAllDirectChannels
post:
  system.allInstances("MessageChannel").select(element.Status = 0).removeAll



context App::CorrectFoldersElementsOrder
post:
  self.Groups.forAll(element.AllFolders.forAll(f | f.ReorderElements()))
  self.Users.forAll(element.AllFolders.forAll(f | f.ReorderElements()))

context App::Upgrade602
post:
  self.CheckArchiveFolders
  self.CheckGroupProjects



admin
context App::CheckArchiveFolders
post:
  self.Users.forAll(element.CheckArchiveFolders)
  self.Groups.forAll(element.CheckArchiveFolders)


context User::CheckArchiveFolders
post:
  if self.TrashFolder.isNull then
    self.TrashFolder = new Folder
    self.TrashFolder.Title = "Trash (" + self.Name + ")"
  end if

  if self.ArchiveFolder.isNull then
    self.ArchiveFolder = new Folder
    self.ArchiveFolder.Title = "Archive (" + self.Name + ")"
  end if

context Group::CheckArchiveFolders
post:
  if self.TrashFolder.isNull then
    self.TrashFolder = new Folder
    self.TrashFolder.Title = "Trash (" + self.Name + ")"
  end if

  if self.ArchiveFolder.isNull then
    self.ArchiveFolder = new Folder
    self.ArchiveFolder.Title = "Archive (" + self.Name + ")"
  end if

admin
context App::CheckGroupProjects
post:
  self.Groups.forAll(element.CheckProjects)

context Group::CheckProjects
post:
  if self.Projects.first = null then
    self.Projects.newElement (element.Title = "Project P1")
  end if
