
const RSCO_SUBFOLDERS = &h01
const RSCO_ELEMENTS =   &h02
const RSCO_PARENTS  =   &h04
----------------------------------------------------------------------------------
-----  General hard service reset
----------------------------------------------------------------------------------

admin
context App::ResetServiceCodes
post:
    system.allInstances("Folder").forAll(element.ServiceCode = 0)
    system.allInstances("Note").forAll(element.ServiceCode = 0)
    system.allInstances("Task").forAll(element.ServiceCode = 0)
    system.allInstances("Project").forAll(element.ServiceCode = 0)
    system.allInstances("UploadedFile").forAll(element.ServiceCode = 0)

----------------------------------------------------------------------------------
----  Runtime sub structure reset prefered before recursive data recalculation
----------------------------------------------------------------------------------


context Folder::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
        self.ServiceCode = code
        if options & RSCO_SUBFOLDERS then
            self.Folders.forAll(element.Folder.ResetServiceCode(code, options))
        end if
        if options & RSCO_ELEMENTS then
            self.Notes.forAll(element.Note.ResetServiceCode(code, options))
            self.Tasks.forAll(element.Task.ResetServiceCode(code, options))
            self.Files.forAll(element.File.ResetServiceCode(code, options))
        end if
        if options & RSCO_PARENTS then
            self.InFolders.forAll(element.InFolder.ResetServiceCode(code, options))
        end if
    end if


context Note::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
        self.ServiceCode = code
        if options & RSCO_ELEMENTS then
            self.Notes.forAll(element.Note.ResetServiceCode(code, options))
            self.Files.forAll(element.File.ResetServiceCode(code, options))
        end if
        if options & RSCO_PARENTS then
          self.InFolders.forAll(element.Folder.ResetServiceCode(code, options))
          self.InTasks.forAll(element.Task.ResetServiceCode(code, options))
        end if
    end if


context Task::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
        self.ServiceCode = code
        if options & RSCO_ELEMENTS then
            self.Notes.forAll(element.Note.ResetServiceCode(code, options))
            self.Files.forAll(element.File.ResetServiceCode(code, options))
        end if
        if options & RSCO_PARENTS then
            self.InFolders.forAll(element.Folder.ResetServiceCode(code, options))
        end if
    end if


context UploadedFile::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
        self.ServiceCode = code

        if options & RSCO_PARENTS then
            self.InFolders.forAll(element.Folder.ResetServiceCode(code, options))
        end if
    end if

context TaskList::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
      self.ServiceCode = code
      self.AllTasks.forAll(element.ResetServiceCode(code, options))
    end if

context Project::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    if self.ServiceCode <> code then
      self.ServiceCode = code
      self.AllLists.forAll(element.ResetServiceCode(code, options))
      self.Folders.ResetServiceCode(code, options)
    end if


----------------------------------------------------------------------------------
----  Special purposes Service code resets
----------------------------------------------------------------------------------

context Group::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    self.Folders.forAll(element.ResetServiceCode(code, options))
    self.SharedFolders.ResetServiceCode(code, options)
    self.ArchiveFolder.ResetServiceCode(code, options)
    self.TrashFolder.ResetServiceCode(code, options)
    self.AllProjects.forAll(element.ResetServiceCode(code, options))
    self.AllLists.forAll(element.AllTasks.forAll(element.ResetServiceCode(code, options)))


context User::ResetServiceCode(code: integer, optional options: integer = 0)
post:
    self.Folders.forAll(element.ResetServiceCode(code, options))
    self.SharedFolders.ResetServiceCode(code, options)
    self.PinnedFolders.ResetServiceCode(code, options)
    self.BasketFolder.ResetServiceCode(code, options)
    self.ArchiveFolder.ResetServiceCode(code, options)
    self.TrashFolder.ResetServiceCode(code, options)
    self.AllLists.forAll(element.AllTasks.forAll(element.ResetServiceCode(code, options)))