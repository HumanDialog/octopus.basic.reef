----------- GroupMember ------------------------------------------------

access role Tester: Acc Tester
    acc App = ACC_READ

    acc User = self.AccTester

    acc Group = self.AccTester

    acc TaskList = self.AccTester

    acc UserTaskList = self.List.AccTester

    acc Task = self.AccTester

    acc TaskNote = self.Task.AccTester

    acc Folder = self.AccTester

    acc FolderFolder = self.InFolder.Acc

    acc FolderNote = self.Folder.Acc

    acc FolderTask = self.Folder.Acc

    acc Note = self.AccTester

    acc MessageChannel = self.AccTester

    acc Message = self.AccTester

    acc UploadedFile = self.AccTester

    acc FolderFile = self.Folder.Acc

    acc TaskFile = self.Task.AccTester

    acc NoteFile = self.Note.AccTester

    acc NoteNote = self.Note.AccTester

    acc Project = self.AccTester


context User::AccTester: integer
post:
    if self = user then
        result = ACC_READWRITE
    else if self.Groups.exists(element.GroupId = group.Id) then
        result = ACC_READ
    end if
    end if

context Group::AccTester: integer
post:
    if group = self then
        result = ACC_READWRITE
    else if user.IsInGroup(self) then
        result = ACC_READWRITE
    else if self.IsPublic then
        result = ACC_READ
    else if self.Name = "Guests" then
        result = ACC_READ
    end if
    end if
    end if
    end if

context TaskList::AccTester: integer
post:
    if self.User = user then
        result = ACC_READWRITE
    else if self.Group then
        result = self.Group.acc
    else if self.IsSubscribed then
        result = ACC_READWRITE
    end if
    end if
    end if


context Task::AccTester: integer
post:
    ---- Safety
    if self.CreatedBy = user or self.Actor = user or self.TaskList.UserId = user.Id or self.TaskList.GroupId = group.Id then
        result = ACC_READWRITE
    end if

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user or self.Actor = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select




-- Every object has User and Group
-- AccCode points checking criteria
--   but: Owner has superpower access becouse of elements creation
context Folder::AccTester: integer
post:
    if self.Owner = user then
        result = ACC_READWRITE
    end if

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.Owner = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.Group = group then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select



context Note::AccTester: integer
post:
    if self.CreatedBy = user then
        result = ACC_READWRITE
    end if

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select


context MessageChannel::AccTester
post:
    if self.Group = group then
        result = ACC_READ
    else if self.Users.exists(element.UserId = user.Id) then
        result = ACC_READ
    end if
    end if

context Message::AccTester
post:
    if self.Author = self then
        result = ACC_READ
    else if self.Channel.acc >= ACC_READ then
        result = ACC_READ
    end if
    end if

context UploadedFile::AccTester: integer
post:
    if self.CreatedBy = user then
        result = ACC_READWRITE
    end if

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

context Project::AccTester: integer
post:
    if self.Group = group then
        result = ACC_READWRITE
    end if
    app.MigrateFrom_143_to_144