----------- GroupMember ------------------------------------------------

access role Consultant: Consultant
    acc App = ACC_READ

    acc User = self.AccConsultant

    acc Group = self.AccConsultant

    acc TaskList = self.AccConsultant

    acc UserTaskList = self.List.AccConsultant

    acc Task = self.AccConsultant

    acc TaskNote = self.Task.AccConsultant

    acc Folder = self.AccConsultant

    acc FolderFolder = self.InFolder.acc

    acc FolderNote = self.Folder.acc

    acc FolderTask = self.Folder.acc

    acc Note = self.AccConsultant

    acc MessageChannel = self.AccConsultant

    acc Message = self.AccConsultant

    acc UploadedFile = self.AccConsultant

    acc FolderFile = self.Folder.acc

    acc TaskFile = self.Task.AccConsultant

    acc NoteFile = self.Note.AccConsultant

    acc NoteNote = self.Note.AccConsultant

    acc Project = self.AccConsultant

--std
context User::AccConsultant: integer
post:
    if self = user then
        result = ACC_READWRITE
    else if self.Groups.exists(element.GroupId = group.Id) then
        result = ACC_READ --ACC_READ_REF, ACC_READ_BASIC
    end if
    end if

context Group::AccConsultant: integer
post:
    if group = self then
        result = ACC_READ
    end if

context TaskList::AccConsultant: integer
post:
    if self.User = user then
        result = ACC_READWRITE
    else if self.Group then
        result = ACC_READWRITE
    end if
    end if


context Task::AccConsultant: integer
post:
    ---- Safety
    if self.CreatedBy = user or self.Actor = user or self.TaskList.UserId = user.Id then
        result = ACC_READWRITE

    else

    if self.TaskList.GroupId = group.Id then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user or self.Actor = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if
    end if



-- Every object has User and Group
-- AccCode points checking criteria
--   but: Owner has superpower access becouse of elements creation
context Folder::AccConsultant: integer
post:
    if self.Owner = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.Owner = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.Group = group then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if

context Note::AccConsultant: integer
post:
    if self.CreatedBy = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READWRITE
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READWRITE
         end if
    case ACC_PUBLIC
        result = ACC_READWRITE
    end select

    end if

context MessageChannel::AccConsultant
post:
    if self.Group = group then
        result = ACC_READ
    else if self.Users.exists(element.UserId = user.Id) then
        result = ACC_READ
    end if
    end if

context Message::AccConsultant
post:
    if self.Author = self then
        result = ACC_READWRITE
    else if self.Channel.acc >= ACC_READ then
        result = ACC_READ
    end if
    end if

context UploadedFile::AccConsultant: integer
post:
    if self.CreatedBy = user then
        result = ACC_READ

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER
        if self.CreatedBy = user then
            result = ACC_READ
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if
    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READ
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if

context Project::AccConsultant: integer
post:
    if self.Group = group then
        result = ACC_READ
    end if
