----------- GroupMember ------------------------------------------------

access role Customer: Customer
    acc App = ACC_READ

    acc User = self.AccCustomer

    acc Group = self.AccCustomer

    acc TaskList = self.AccCustomer

    acc UserTaskList = self.List.AccCustomer

    acc Task = self.AccCustomer

    acc TaskNote = self.Task.AccCustomer

    acc Folder = self.AccCustomer

    acc FolderFolder = self.InFolder.acc

    acc FolderNote = self.Folder.acc

    acc FolderTask = self.Folder.acc

    acc Note = self.AccCustomer

    acc MessageChannel = self.AccCustomer

    acc Message = self.AccCustomer

    acc UploadedFile = self.AccCustomer

    acc FolderFile = self.Folder.acc

    acc TaskFile = self.Task.AccCustomer

    acc NoteFile = self.Note.AccCustomer

    acc NoteNote = self.Note.AccCustomer

    acc Project = self.AccCustomer

--std
context User::AccCustomer: integer
post:
    if self = user then
        result = ACC_READWRITE
    else if self.Groups.exists(element.GroupId = group.Id) then
        result = ACC_READ --ACC_READ_REF, ACC_READ_BASIC
    end if
    end if

context Group::AccCustomer: integer
post:
    if group = self then
        result = ACC_READ
    end if

context TaskList::AccCustomer: integer
post:
    if self.User = user then
        result = ACC_READWRITE
    else if self.Group then
        result = self.Group.acc
    end if
    end if


context Task::AccCustomer: integer
post:
    ---- Safety
    if self.CreatedBy = user or self.Actor = user or self.TaskList.UserId = user.Id then
        result = ACC_READWRITE

    else

    if self.TaskList.GroupId = group.Id then
        result = ACC_READ

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER, ACC_USER_CONFIDENTIAL, ACC_USER_RESTRICTED
        if self.CreatedBy = user or self.Actor = user then
            result = ACC_READWRITE
        end if

    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if

    case ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        --if self.CreatedBy = user ... alredy checket at the beginning
        result = ACC_DENIED

    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READ
        end if

    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if

    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if
    end if

-- Every object has User and Group
-- AccCode points checking criteria
--   but: Owner has superpower access becouse of elements creation
context Folder::AccCustomer: integer
post:
    if self.Owner = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER, ACC_USER_CONFIDENTIAL, ACC_USER_RESTRICTED
        if self.Owner = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READ
         end if

    case ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        --if self.CreatedBy = user ... alredy checket at the beginning
        result = ACC_DENIED

    case ACC_GROUP
        if self.Group = group then
            result = ACC_READ
        end if

    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder
         if  shared.InFolders.exists (element.GroupId = group.Id) then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if


context Note::AccCustomer: integer
post:
    if self.CreatedBy = user then
        result = ACC_READWRITE

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER, ACC_USER_CONFIDENTIAL, ACC_USER_RESTRICTED
        if self.CreatedBy = user then
            result = ACC_READWRITE
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if

    case ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        --if self.CreatedBy = user ... alredy checket at the beginning
        result = ACC_DENIED

    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READ
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if

context MessageChannel::AccCustomer
post:
    if self.Group = group then
        result = ACC_READ
    else if self.Users.exists(element.UserId = user.Id) then
        result = ACC_READ
    end if
    end if

context Message::AccCustomer
post:
    if self.Author = self then
        result = ACC_READ
    else if self.Channel.acc >= ACC_READ then
        result = ACC_READ
    end if
    end if

context UploadedFile::AccCustomer: integer
post:
    if self.CreatedBy = user then
        result = ACC_READ

    else

    let shared: Folder
    select case self.AccCode
    case ACC_USER, ACC_USER_CONFIDENTIAL, ACC_USER_RESTRICTED
        if self.CreatedBy = user then
            result = ACC_READ
        end if
    case ACC_USER_SHARED
         shared = self.GetUserSharedFolder(user)
         if shared then
             result = ACC_READ
         end if

    case ACC_GROUP_CONFIDENTIAL, ACC_GROUP_RESTRICTED
        --if self.CreatedBy = user ... alredy checket at the beginning
        result = ACC_DENIED

    case ACC_GROUP
        if self.GroupId = group.Id then
            result = ACC_READ
        end if
    case ACC_GROUP_SHARED
         shared = self.GetGroupSharedFolder(group)
         if shared then
             result = ACC_READ
         end if
    case ACC_PUBLIC
        result = ACC_READ
    end select

    end if


context Project::AccCustomer: integer
post:
    if self.Group = group then
        result = ACC_READ
    end if
