context Group::GetUnapprovedPostsFolder: Folder
post:
    if self.UnapprovedPosts.isNull then
        self.UnapprovedPosts = self.AllFolders.newElement(e | 
            e.Title = "__; en: Unapproved posts; es: Publicaciones no aprobadas; pl: Niezatwierdzone posty"
            e.Status = FS_GROUP_UNAPPROVED_POSTS_FOLDER
            e.Kind = FK_FEED)
    end if

    result = self.UnapprovedPosts

 --   result = self.UnapprovedPosts
