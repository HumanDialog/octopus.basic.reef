const FEED_MAX_ELEMENTS_NO    = 100

class UserFolder
    Folder:     Folder      <backNav: SubscribedBy>
    User:       User        <backNav: SubscribedFolders>
end class


constraint Group::FeedsRoot
    element.GroupId = self.Id and element.Status = FS_GROUP_ROOT_FEEDS_FOLDER

constraint Group::UnapprovedPosts
    element.GroupId = self.Id and element.Status = FS_GROUP_UNAPPROVED_POSTS_FOLDER

constraint User::MyFeed
    element.UserId = self.Id and element.Status = FS_USER_MY_FEED_FOLDER

constraint User::MySentPosts
    element.UserId = self.Id and element.Status = FS_USER_MY_SENT_POSTS_FOLDER

constraint User::MyDraftPosts
    element.UserId = self.Id and element.Status = FS_USER_MY_DRAFT_POSTS_FOLDER


context Group::GetFeedsRootFolder: Folder
post:
    if self.FeedsRoot.isNull then
        self.FeedsRoot = self.AllFolders.newElement(e | e.Title = "Feeds" and e.Status = FS_GROUP_ROOT_FEEDS_FOLDER)
    end if

    result = self.FeedsRoot

